#include <Adafruit_LSM6DS3TRC.h>
#include <Adafruit_LIS3MDL.h>

#include <micro_ros_arduino.h>
#include <rcl/rcl.h>
#include <rclc/rclc.h>
#include <rclc/executor.h>

#include <sensor_msgs/msg/imu.h>
#include <sensor_msgs/msg/magnetic_field.h>

Adafruit_LSM6DS3TRC lsm6ds;
Adafruit_LIS3MDL lis3mdl;

rcl_publisher_t imu_pub;
rcl_publisher_t mag_pub;
rcl_node_t node;
rclc_support_t support;
rcl_allocator_t allocator;
rcl_timer_t timer;
rclc_executor_t executor;

sensor_msgs__msg__Imu imu_msg;
sensor_msgs__msg__MagneticField mag_msg;

#define RCCHECK(fn) { rcl_ret_t temp_rc = fn; if ((temp_rc != RCL_RET_OK)) { while(1); }}
#define RCSOFTCHECK(fn) { rcl_ret_t temp_rc = fn; if ((temp_rc != RCL_RET_OK)) {} }

void timer_callback(rcl_timer_t * timer, int64_t last_call_time) {
  if (timer == NULL) return;

  // Read IMU
  sensors_event_t accel, gyro, temp;
  lsm6ds.getEvent(&accel, &gyro, &temp);

  // Fill IMU message
  imu_msg.linear_acceleration.x = accel.acceleration.x;
  imu_msg.linear_acceleration.y = accel.acceleration.y;
  imu_msg.linear_acceleration.z = accel.acceleration.z;

  imu_msg.angular_velocity.x = gyro.gyro.x;
  imu_msg.angular_velocity.y = gyro.gyro.y;
  imu_msg.angular_velocity.z = gyro.gyro.z;

  // Zero orientation (you can use sensor fusion later if needed)
  imu_msg.orientation.x = 0.0;
  imu_msg.orientation.y = 0.0;
  imu_msg.orientation.z = 0.0;
  imu_msg.orientation.w = 1.0;

  RCSOFTCHECK(rcl_publish(&imu_pub, &imu_msg, NULL));

  // Read magnetometer
  lis3mdl.read();
  mag_msg.magnetic_field.x = lis3mdl.x * 1e-6;
  mag_msg.magnetic_field.y = lis3mdl.y * 1e-6;
  mag_msg.magnetic_field.z = lis3mdl.z * 1e-6;

  RCSOFTCHECK(rcl_publish(&mag_pub, &mag_msg, NULL));
}

void setup() {
  Serial.begin(115200);
  delay(2000);  // allow time for serial monitor
  set_microros_transports();

  Wire.begin(21, 22);  // ESP32 I2C pins

  if (!lsm6ds.begin_I2C(0x6A)) {
    Serial.println("Failed to find LSM6DS3TRC");
    while (1);
  }

  if (!lis3mdl.begin_I2C(0x1C)) {
    Serial.println("Failed to find LIS3MDL");
    while (1);
  }

  allocator = rcl_get_default_allocator();
  RCCHECK(rclc_support_init(&support, 0, NULL, &allocator));
  RCCHECK(rclc_node_init_default(&node, "imu_node", "", &support));

  RCCHECK(rclc_publisher_init_default(
    &imu_pub,
    &node,
    ROSIDL_GET_MSG_TYPE_SUPPORT(sensor_msgs, msg, Imu),
    "imu/data_raw"));

  RCCHECK(rclc_publisher_init_default(
    &mag_pub,
    &node,
    ROSIDL_GET_MSG_TYPE_SUPPORT(sensor_msgs, msg, MagneticField),
    "imu/mag"));

  const unsigned int timer_timeout = 100;  // 10Hz
  RCCHECK(rclc_timer_init_default(
    &timer,
    &support,
    RCL_MS_TO_NS(timer_timeout),
    timer_callback));

  RCCHECK(rclc_executor_init(&executor, &support.context, 1, &allocator));
  RCCHECK(rclc_executor_add_timer(&executor, &timer));

  Serial.println("IMU + Magnetometer micro-ROS node started.");
}

void loop() {
  rclc_executor_spin_some(&executor, RCL_MS_TO_NS(100));
}

